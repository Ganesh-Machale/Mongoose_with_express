<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your message</title>
</head>
<body>
    <h1>Edit your message: <%= chat.id %></h1>
    <p>This chat is send : from  <b><%= chat.from %></b>  TO  <b> <%= chat.to %></b></p>
    <p>Type your New Message Here :</p>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="10" cols="40">  <%= chat.msg %></textarea><br>
        <button>Edit</button>
    </form>
</body>
</html>